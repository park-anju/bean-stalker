# Bean Stalker web — example environment. NEVER put real values here.
# Copy to apps/web/.env.local (gitignored). Full inventory + classification:
# docs/13_OPERATIONS/Environment Contract.md
#
# Every value here is PUBLIC CONFIG. Vite inlines VITE_-prefixed values into the
# browser bundle. The Maps JavaScript key and Map ID are browser-visible by
# design (protected Google-side by referrer + API restrictions) — NOT secrets.
# The server-only GOOGLE_PLACES_SERVER_KEY must never appear here or be
# VITE_-prefixed.

# public config — bare http(s) origin the client prefixes onto /api/v1/...
VITE_API_BASE_URL=http://localhost:3001

# public config — restricted browser Maps JavaScript key.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# public config — Map ID for Advanced Markers. Use DEMO_MAP_ID for local/test;
# a real Cloud-configured, referrer-restricted Map ID for a deployed build.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
