# Bean Stalker API — example environment. NEVER put real values here.
# Copy to apps/api/.env (gitignored) and fill in for your machine.
# Classification + full inventory: docs/13_OPERATIONS/Environment Contract.md
#
#   sensitivity: public config | operational config | SECRET
#   the ONLY secret below is GOOGLE_PLACES_SERVER_KEY — server-only, never
#   VITE_-prefixed, never in the frontend build (enforced by
#   `pnpm --filter @bean-stalker/web build`).

# operational config — required
PORT=3001

# operational config — required. Bare http(s) origin for API CORS; no path/query.
WEB_ORIGIN=http://localhost:5173

# SECRET — required ONLY when CAFE_PROVIDER=live. Leave this line commented out
# for fixture mode (an empty value is rejected as an invalid secret). For live
# mode, uncomment and paste a restricted Places-API server key.
# GOOGLE_PLACES_SERVER_KEY=

# operational config — optional (default 10000; max 30000).
GOOGLE_PLACES_TIMEOUT_MS=5000

# operational config — live | fixture (default live). Use `fixture` for routine
# local dev/tests: no credential, no billable Google traffic.
CAFE_PROVIDER=fixture

# operational config — optional. fatal|error|warn|info|debug|trace|silent (default info).
LOG_LEVEL=info

# operational config — per-client rate limit on POST /api/v1/cafes/search (H03).
SEARCH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW_MS=60000

# operational config — global metered-provider monthly attempt cap (H04).
# REQUIRED when CAFE_PROVIDER=live; ignored in fixture mode. `0` = "no live
# provider attempts this period". The in-memory guard is NOT a production
# financial hard cap — see docs/10_DECISIONS/ADR-008 and BLK-004.
PROVIDER_MONTHLY_REQUEST_LIMIT=700
