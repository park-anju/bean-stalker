# Never commit real values. See docs/04_AUTHORITY/API Key Boundaries.md.
# This server key must never be exposed to the browser or prefixed with VITE_.
PORT=3001
WEB_ORIGIN=http://localhost:5173
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_PLACES_TIMEOUT_MS=5000
# live | fixture. Use `fixture` for routine local dev/tests: no billable Google
# traffic. `live` requires a real restricted GOOGLE_PLACES_SERVER_KEY.
CAFE_PROVIDER=fixture

# --- observability (H02) ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- per-client rate limit on POST /api/v1/cafes/search (H03) ---
SEARCH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW_MS=60000

# --- global metered-provider monthly attempt cap (H04) ---
# REQUIRED when CAFE_PROVIDER=live. Ignored in fixture mode. `0` means "no live
# provider attempts this period". The in-memory guard is NOT a production
# financial hard cap — see docs/10_DECISIONS/ADR-008 and BLK-004.
PROVIDER_MONTHLY_REQUEST_LIMIT=700
